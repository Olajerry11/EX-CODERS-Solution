# =============================================================================
# EX-DIGITAL — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://exdigital:exdigital_secret@localhost:5432/exdigital_db
POSTGRES_USER=exdigital
POSTGRES_PASSWORD=exdigital_secret
POSTGRES_DB=exdigital_db

# ── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External Portal / ERP Integration ──────────────────────────────────────
EXTERNAL_PORTAL_BASE_URL=https://portal.university.edu/api/v1
EXTERNAL_PORTAL_API_KEY=your_external_api_key_here

# ── Flask Integration Gateway ──────────────────────────────────────────────
FLASK_SECRET_KEY=CHANGE_ME_FLASK_SECRET
FLASK_PORT=5001
GATEWAY_API_KEY=exdigital_gateway_secret_key

# ── Sync Settings ──────────────────────────────────────────────────────────
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRIES=5

# ── FastAPI Core Server ────────────────────────────────────────────────────
FASTAPI_PORT=8000
